# ---------------------------------------------------------------------------
# Keren — environment configuration
# Copy to .env.local and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# Database (PostgreSQL). Local dev example:
# postgresql://postgres:postgres@localhost:5432/keren
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/keren"

# NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET="yEL4D/TZYOOPrk7d9AOvchOvdCJ+vyh4qhMO7pJ3IzY="
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI (https://platform.openai.com/api-keys)
# AI features degrade gracefully with clear "AI unavailable" states if unset.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL="gpt-4o-mini"

# File storage — S3-compatible (Supabase Storage, AWS S3, etc.)
# Left unset in dev: uploads are rejected with a clear "storage not configured" error
# rather than silently writing to local disk.
STORAGE_PROVIDER="none" # "s3" | "none"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""

# Payments — abstracted; Paystack is the initial provider (see lib/billing)
PAYMENTS_PROVIDER="none" # "paystack" | "none"
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# Email (deadline reminders, notifications) — Resend recommended
RESEND_API_KEY=""
EMAIL_FROM="Keren <notifications@keren.chopute.com>"
