{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/opportunity-discovery.ts": {
      "maxDuration": 60,
      "experimentalTriggers": [
        {
          "type": "schedule/v1beta"
        }
      ]
    }
  },
  "schedules": {
    "keren-opportunity-discovery": {
      "schedule": "*/15 * * * *",
      "timezone": "Africa/Lagos",
      "function": "api/opportunity-discovery"
    }
  }
}
